---
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/PageLayout.astro";
import Card from "@/components/Card.astro";
import { getCategoryGroups, type WritingGroup } from "@/utils/writing";

export async function getStaticPaths() {
  return getCategoryGroups(await getCollection("posts")).map(group => ({
    params: { category: group.slug },
    props: { group },
  }));
}
type Props = { group: WritingGroup };
const { group } = Astro.props;
---

<PageLayout
  title={`${group.name} | Writing`}
  description={`Articles filed under ${group.name}.`}
>
  <a class="text-link" href="/writing/">← All writing</a>
  <p class="eyebrow">Category</p>
  <h1 class="page-heading">{group.name}</h1>
  <ul class="article-list" aria-label={`${group.name} articles`}>
    {group.posts.map(post => <Card {...post} />)}
  </ul>
</PageLayout>
