---
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/PageLayout.astro";
import Card from "@/components/Card.astro";
import { getSeriesGroups, type WritingGroup } from "@/utils/writing";

export async function getStaticPaths() {
  return getSeriesGroups(await getCollection("posts")).map(group => ({
    params: { series: group.slug },
    props: { group },
  }));
}
type Props = { group: WritingGroup };
const { group } = Astro.props;
const name = group.name;
---

<PageLayout title={`${name} | Writing`} description={`Read ${name} in order.`}>
  <a class="text-link" href="/writing/">← All writing</a>
  <p class="eyebrow">Series</p>
  <h1 class="page-heading">{name}</h1>
  <p class="lede">
    {group.posts.length}
    {group.posts.length === 1 ? "article" : "articles"}, in reading order.
  </p>
  {
    group.slug === "fogcast-notes" && (
      <p>
        Explore the{" "}
        <a class="text-link" href="https://fogcast.today">
          live forecast ↗
        </a>{" "}
        and{" "}
        <a class="text-link" href="https://github.com/gbeardsell/fogcast">
          code on GitHub ↗
        </a>
        .
      </p>
    )
  }
  <ol class="series-articles" aria-label={`${name} reading order`}>
    {group.posts.map(post => <Card {...post} />)}
  </ol>
</PageLayout>

<style>
  .series-articles {
    max-width: 46rem;
    margin: 0;
    padding-inline-start: 1.8rem;
    list-style: decimal;
  }
  .series-articles :global(.article-card) {
    padding-inline-start: 0.4rem;
  }
  .series-articles :global(.article-card::marker) {
    color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;
  }
</style>
