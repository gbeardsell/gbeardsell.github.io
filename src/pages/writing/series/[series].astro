---
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/PageLayout.astro";
import Card from "@/components/Card.astro";
import { getSeriesGroups, type WritingGroup } from "@/utils/writing";

export async function getStaticPaths() {
  return getSeriesGroups(await getCollection("posts")).map(group => ({
    params: { series: group.slug },
    props: { group },
  }));
}
type Props = { group: WritingGroup };
const { group } = Astro.props;
---

<PageLayout
  title={`${group.name} | Writing`}
  description={`Read ${group.name} in order.`}
>
  <a class="text-link" href="/writing/">← All writing</a>
  <p class="eyebrow">Series</p>
  <h1 class="page-heading">{group.name}</h1>
  <p class="lede">
    {group.posts.length}
    {group.posts.length === 1 ? "article" : "articles"}, in reading order.
  </p>
  <ol class="article-list" aria-label={`${group.name} reading order`}>
    {group.posts.map(post => <Card {...post} />)}
  </ol>
</PageLayout>
