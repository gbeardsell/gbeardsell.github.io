---
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/PageLayout.astro";
import FogcastFeature from "@/components/FogcastFeature.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";
const posts = getSortedPosts(await getCollection("posts")).slice(
  0,
  config.posts.perIndex
);
---

<PageLayout>
  <section class="hero" aria-labelledby="intro-heading">
    <p class="eyebrow">Scientific computing · Mechanical engineering</p>
    <h1 id="intro-heading" class="hero-heading">
      Understanding physics<br />through computation.
    </h1>
    <p class="intro">
      I’m Guillaume Beardsell, a computational scientist and mechanical
      engineer. My work brings together numerical methods, simulation, and
      physical understanding.
    </p>
    <div class="intro-links">
      <a class="text-link" href="/about/"
        >More about me <span aria-hidden="true">→</span></a
      >
      <a href="https://github.com/gbeardsell"
        >GitHub <span aria-hidden="true">↗</span></a
      >
    </div>
  </section>
  <section aria-labelledby="project-heading" class="featured-section">
    <div class="section-top">
      <h2 id="project-heading" class="section-heading">In progress</h2>
      <a class="text-link" href="/projects/"
        >All projects <span aria-hidden="true">→</span></a
      >
    </div>
    <FogcastFeature />
  </section>
  <section class="content-section" aria-labelledby="writing-heading">
    <div class="section-top">
      <h2 id="writing-heading" class="section-heading">Recent writing</h2>
      <a class="text-link" href="/writing/"
        >All writing <span aria-hidden="true">→</span></a
      >
    </div>
    {
      posts.length ? (
        <ul class="article-list">
          {posts.map(post => (
            <Card {...post} />
          ))}
        </ul>
      ) : (
        <div class="empty-state">
          <p>
            No articles published yet. This will be a place for notes on
            scientific computing, numerical methods, and the development of
            Fogcast.
          </p>
        </div>
      )
    }
  </section>
</PageLayout>
<style>
  .hero {
    padding: 0.6rem 0 4.5rem;
  }
  .hero-heading {
    font-size: clamp(2.75rem, 5.3vw, 4.6rem);
    margin: 1.5rem 0 1.7rem;
  }
  .intro {
    max-width: 40rem;
    color: var(--muted-foreground);
    font-size: 1.1rem;
    line-height: 1.8;
  }
  .intro-links {
    display: flex;
    align-items: center;
    gap: 1.7rem;
    margin-top: 1.6rem;
    font-size: 0.84rem;
  }
  .intro-links > a:not(.text-link) {
    text-decoration: none;
    color: var(--muted-foreground);
  }
  @media (max-width: 700px) {
    .hero {
      padding: 0 0 3rem;
    }
    .hero-heading {
      margin-top: 1.3rem;
    }
    .hero .eyebrow {
      max-width: 19rem;
      line-height: 1.8;
    }
  }
</style>
