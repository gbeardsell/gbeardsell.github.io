---
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/PageLayout.astro";
import FogcastSketch from "@/components/FogcastSketch.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
const posts = getSortedPosts(await getCollection("posts")).filter(post =>
  post.data.categories.some(category => category.toLowerCase() === "fogcast")
);
---

<PageLayout
  title="Fogcast"
  description="A work-in-progress project exploring Bay Area clear-sky forecasts on an intended 500 m grid."
>
  <a class="back-link" href="/projects/"
    ><span aria-hidden="true">←</span> Projects</a
  >
  <div class="project-intro">
    <div>
      <p class="eyebrow">Bay Area · Work in progress</p>
      <h1 class="page-heading">Fogcast</h1>
      <p class="project-deck">Where will the sky clear next?</p>
      <p class="lede">
        Local clear-sky forecasting for the San Francisco Bay Area.
      </p>
      <a class="text-link" href="https://github.com/gbeardsell/fogcast">
        Code &amp; documentation <span aria-hidden="true">↗</span>
      </a>
    </div>
    <FogcastSketch />
  </div>
  <div class="project-body">
    <div class="prose-content">
      <h2>The problem</h2>
      <p>
        Knowing whether the sky will be clear is a local question. Fogcast
        explores how satellite observations and weather-model inputs can support
        clear-sky forecasts across the Bay Area.
      </p>
      <h2>The planned approach</h2>
      <p>
        The intended forecast grid has a spacing of 500 m. Satellite
        observations will describe cloud conditions, while weather-model inputs
        will provide information about the evolving atmosphere.
      </p>
      <p>
        The aim is to combine these inputs into useful local forecasts. The grid
        spacing is a design target; forecast skill at that scale still needs to
        be demonstrated.
      </p>
      <h2>How it will be evaluated</h2>
      <p>
        Planned evaluation will compare Fogcast against persistence, which
        carries the latest observed conditions forward, and the National Blend
        of Models (NBM). These comparisons will help establish whether the
        approach adds useful forecasting skill.
      </p>
      <h2>Current status</h2>
      <p>
        Fogcast is a work in progress. Selected implementations and project
        documentation are available in the public repository. Results, technical
        articles, and a live forecast will be linked here as they become
        available.
      </p>
    </div>
    <aside class="project-facts" aria-label="Project at a glance">
      <p class="eyebrow">At a glance</p>
      <dl>
        <div><dt>Focus</dt><dd>Clear-sky forecasting</dd></div>
        <div><dt>Region</dt><dd>San Francisco Bay Area</dd></div>
        <div><dt>Intended grid</dt><dd>500 m</dd></div>
        <div>
          <dt>Inputs</dt><dd>
            Satellite observations<br />Weather-model inputs
          </dd>
        </div>
        <div><dt>Evaluation baselines</dt><dd>Persistence<br />NBM</dd></div>
      </dl>
    </aside>
  </div>
  <section class="content-section" aria-labelledby="fogcast-writing">
    <div class="section-top">
      <h2 id="fogcast-writing" class="section-heading">
        Writing about Fogcast
      </h2>
      {
        posts.length > 0 && (
          <a class="text-link" href="/writing/category/fogcast/">
            All Fogcast articles <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
    {
      posts.length ? (
        <ul class="article-list">
          {posts.map(post => (
            <Card {...post} />
          ))}
        </ul>
      ) : (
        <div class="empty-state">
          <p>
            No articles published yet. Future notes will cover the approach,
            implementation, and evaluation.
          </p>
        </div>
      )
    }
  </section>
</PageLayout>
<style>
  .back-link {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--muted-foreground);
    text-decoration: none;
    margin-bottom: 2.5rem;
  }
  .project-intro {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    gap: 3rem;
  }
  .project-deck {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.65rem;
    line-height: 1.4;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }
  .project-body {
    display: grid;
    grid-template-columns: 1fr 17rem;
    gap: 5rem;
    margin-top: 1rem;
  }
  .project-facts {
    border-top: 1px solid var(--border);
    align-self: start;
    margin-top: 3rem;
    padding-top: 1.5rem;
  }
  .project-facts dl {
    margin: 0;
    font-size: 0.88rem;
  }
  .project-facts dl div {
    margin-bottom: 1.25rem;
  }
  .project-facts dt {
    font-size: 0.7rem;
    color: var(--muted-foreground);
    margin-bottom: 0.2rem;
  }
  .project-facts dd {
    margin: 0;
  }
  @media (max-width: 800px) {
    .project-intro {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .project-body {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .project-facts dl {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
  }
</style>
