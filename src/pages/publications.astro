---
import PageLayout from "@/layouts/PageLayout.astro";
import PublicationEntry from "@/components/PublicationEntry.astro";
import { publications, phdThesis } from "@/data/publications";
import { getPublicationImage } from "@/utils/getPublicationImage";

const bibliography = [...publications, phdThesis].sort(
  (a, b) => b.year - a.year
);
const years = [...new Set(bibliography.map(publication => publication.year))];
---

<PageLayout
  title="Publications"
  description="Scientific publications and PhD thesis by Guillaume Beardsell."
>
  <div class="publications">
    <h1 class="page-heading">Publications</h1>
    {
      years.map(year => (
        <section class="publication-year" aria-labelledby={`year-${year}`}>
          <h2 id={`year-${year}`}>{year}</h2>
          <ul class="publication-list">
            {bibliography
              .filter(publication => publication.year === year)
              .map(publication => (
                <PublicationEntry
                  publication={{
                    ...publication,
                    image: getPublicationImage(publication),
                  }}
                />
              ))}
          </ul>
        </section>
      ))
    }
  </div>
</PageLayout>

<style>
  .publications {
    max-width: 60rem;
  }
  .publications > .page-heading {
    margin-bottom: 2.5rem;
  }
  .publication-year {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    column-gap: 1.5rem;
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
  }
  .publication-year h2 {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;
    margin: 0.25rem 0 1rem;
  }
  .publication-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (max-width: 650px) {
    .publication-year {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 1.25rem;
    }
    .publication-year h2 {
      margin-top: 0;
    }
  }
</style>
