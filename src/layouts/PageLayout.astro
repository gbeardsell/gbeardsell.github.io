---
import Layout from "./Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

type Props = { title?: string; description?: string; noindex?: boolean };
const { title, description, noindex = false } = Astro.props;
const pageTitle = title ? title + " | " + config.site.title : config.site.title;
---

<Layout title={pageTitle} {description} {noindex}>
  <Fragment slot="head"><slot name="head" /></Fragment>
  <Header />
  <main
    id="main-content"
    tabindex="-1"
    class="page-main"
    data-pagefind-body={!noindex || undefined}
  >
    <slot />
  </main>
  <Footer />
</Layout>
