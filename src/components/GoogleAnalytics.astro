---
import { PUBLIC_GOOGLE_ANALYTICS_ID } from "astro:env/client";

const measurementId = PUBLIC_GOOGLE_ANALYTICS_ID?.trim();
const productionHostname = Astro.site?.hostname;

if (measurementId && !/^G-[A-Z0-9]+$/.test(measurementId)) {
  throw new Error(
    "PUBLIC_GOOGLE_ANALYTICS_ID must be a GA4 Measurement ID starting with G-."
  );
}
---

<script is:inline define:vars={{ measurementId, productionHostname }}>
  (() => {
    // Production previews and copies on other domains must not send visits.
    if (window.location.hostname !== productionHostname) return;

    window.dataLayer = window.dataLayer || [];
    function gtag() {
      window.dataLayer.push(arguments);
    }
    window.gtag = gtag;
    gtag("js", new Date());
    gtag("config", measurementId, {
      allow_google_signals: false,
      allow_ad_personalization_signals: false,
    });

    const script = document.createElement("script");
    script.async = true;
    script.src = "https://www.googletagmanager.com/gtag/js?id=" + measurementId;
    document.head.appendChild(script);
  })();
</script>
