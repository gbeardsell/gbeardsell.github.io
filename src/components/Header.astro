---
import config from "@/config";
const links = [
  { href: "/", label: "Blog" },
  { href: "https://fogcast.today", label: "fogcast.today" },
  { href: "https://github.com/gbeardsell/fogcast", label: "Fogcast GitHub" },
  {
    href: "https://www.linkedin.com/in/guillaume-beardsell",
    label: "LinkedIn",
  },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" && (path === "/" || path.startsWith("/writing/"));
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header" data-pagefind-ignore>
  <a class="site-name" href="/" aria-label="Guillaume Beardsell — home">
    <img
      class="site-icon"
      src="/fogcast-icon.png"
      alt=""
      width="28"
      height="28"
    />
    <span>{config.site.title}</span>
  </a>
  <nav aria-label="Main navigation">
    <ul class="site-nav">
      {
        links.map(({ href, label }) => (
          <li>
            <a
              {href}
              target={href.startsWith("https://") ? "_blank" : undefined}
              rel={
                href.startsWith("https://") ? "noopener noreferrer" : undefined
              }
              aria-current={isActive(href) ? "page" : undefined}
            >
              {label}
              {href.startsWith("https://") && (
                <span aria-hidden="true"> ↗</span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
