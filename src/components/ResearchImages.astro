---
import { Image } from "astro:assets";
import turbulentFlame from "../../pictures/TurbulentFlame_E.png";
import opticalEngine from "../../pictures/OpticalEngineExperiment_Jets.png";

const sizes =
  "(max-width: 650px) min(calc(100vw - 3rem), 483px), (max-width: 1024px) calc((100vw - 5rem) / 2), 472px";
---

<section class="research-images" aria-label="Research images">
  <figure>
    <Image
      src={turbulentFlame}
      alt="Blue, green, yellow, and red regions form a wrinkled, swirling boundary."
      width={483}
      height={300}
      widths={[320, 483]}
      {sizes}
      format="webp"
    />
    <figcaption>Turbulent flame</figcaption>
  </figure>
  <figure>
    <Image
      src={opticalEngine}
      alt="Bright yellow and turquoise jets radiate from a dark center against a blue background."
      width={483}
      height={300}
      widths={[320, 483]}
      {sizes}
      format="webp"
    />
    <figcaption>Optical engine experiment</figcaption>
  </figure>
</section>

<style>
  .research-images {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    max-width: 61rem;
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  figure {
    width: 100%;
    max-width: 483px;
    margin: 0;
  }
  figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    margin-top: 0.8rem;
    color: var(--muted-foreground);
    font-size: 0.85rem;
  }
  @media (max-width: 650px) {
    .research-images {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
