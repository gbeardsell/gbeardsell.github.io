---
import { getCollection, type CollectionEntry } from "astro:content";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getSeriesGroups } from "@/utils/writing";

type Props = { description: string };
const { description } = Astro.props;

type Post = CollectionEntry<"posts">;
const compareSeriesOrder = (a: Post, b: Post) =>
  (a.data.series?.slug ?? "").localeCompare(b.data.series?.slug ?? "") ||
  (a.data.series?.order ?? 0) - (b.data.series?.order ?? 0) ||
  (b.data.modDatetime ?? b.data.pubDatetime).getTime() -
    (a.data.modDatetime ?? a.data.pubDatetime).getTime();

const allPosts = await getCollection("posts");
const posts = getSortedPosts(allPosts);
const series = getSeriesGroups(posts);
const articles = posts.filter(post => !post.data.series);
const drafts = import.meta.env.DEV
  ? allPosts.filter(post => post.data.draft).sort(compareSeriesOrder)
  : [];
---

<div class="writing">
  <h1 class="page-heading">Writing</h1>
  <p class="lede">{description}</p>
  {
    series.map(group => (
      <section class="writing-section" aria-labelledby={`series-${group.slug}`}>
        <h2 id={`series-${group.slug}`} class="section-heading">
          <span class="series-heading">
            {group.slug === "fogcast-notes" && (
              <img
                class="series-icon"
                src="/fogcast-icon.png"
                alt=""
                width="32"
                height="32"
              />
            )}
            <span class="series-title">{group.name}</span>
          </span>
        </h2>
        {group.slug === "fogcast-notes" ? (
          <p class="series-intro">
            A series on building a Bay Area clear-sky forecast, from satellite
            observations to model evaluation. Read the articles in order, or
            explore the{" "}
            <a class="text-link" href="https://fogcast.today">
              live forecast ↗
            </a>{" "}
            and{" "}
            <a class="text-link" href="https://github.com/gbeardsell/fogcast">
              code on GitHub ↗
            </a>
            .
          </p>
        ) : null}
        <ol class="series-articles" aria-label={`${group.name} reading order`}>
          {group.posts.map(post => (
            <Card {...post} variant="h3" />
          ))}
        </ol>
      </section>
    ))
  }
  {
    articles.length > 0 && (
      <section class="writing-section" aria-labelledby="articles-heading">
        <h2 id="articles-heading" class="section-heading">
          Articles
        </h2>
        <ul class="article-list" aria-label="Articles, newest first">
          {articles.map(post => (
            <Card {...post} variant="h3" />
          ))}
        </ul>
      </section>
    )
  }
  {
    posts.length === 0 && drafts.length === 0 ? (
      <div class="empty-state">
        <p>No posts published yet.</p>
      </div>
    ) : null
  }
  {
    drafts.length > 0 && (
      <section class="writing-section" aria-labelledby="drafts-heading">
        <h2 id="drafts-heading" class="section-heading">
          Drafts
        </h2>
        <p>
          These posts are unpublished and visible only in the local preview.
        </p>
        <ul class="article-list" aria-label="Draft posts">
          {drafts.map(post => (
            <Card {...post} variant="h3" />
          ))}
        </ul>
      </section>
    )
  }
</div>

<style>
  .writing {
    max-width: 46rem;
  }
  .writing-section {
    margin-top: 3.5rem;
  }
  .series-heading {
    display: inline-flex;
    flex-flow: row nowrap;
    align-items: center;
    gap: 0.75rem;
    vertical-align: middle;
  }
  .series-title {
    min-width: 0;
    text-wrap: wrap;
  }
  .series-icon {
    display: block;
    width: 32px;
    height: 32px;
    flex: 0 0 32px;
    margin: 0;
    border-radius: 0.35rem;
  }
  .series-intro {
    max-width: 65ch;
    color: var(--muted-foreground);
  }
  .series-articles {
    margin: 0;
    padding-inline-start: 1.8rem;
    list-style: decimal;
  }
  .series-articles :global(.article-card) {
    padding-inline-start: 0.4rem;
  }
  .series-articles :global(.article-card::marker) {
    color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;
  }
</style>
